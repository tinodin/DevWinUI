            <StaticResource x:Key="SubtleIconButtonForegroundPressed" ResourceKey="SystemControlHighlightBaseHighBrush" />
            <StaticResource x:Key="SubtleIconButtonForegroundDisabled" ResourceKey="SystemControlDisabledBaseMediumLowBrush" />
            <StaticResource x:Key="SubtleIconButtonBorderBrush" ResourceKey="SystemControlForegroundTransparentBrush" />
            <StaticResource x:Key="SubtleIconButtonBorderBrushPointerOver" ResourceKey="SystemControlHighlightBaseMediumLowBrush" />
            <StaticResource x:Key="SubtleIconButtonBorderBrushPressed" ResourceKey="SystemControlHighlightTransparentBrush" />
            <StaticResource x:Key="SubtleIconButtonBorderBrushDisabled" ResourceKey="SystemControlDisabledTransparentBrush" />
            <!--  PlayButton (Resources\ButtonResourceDictionary.xaml, HighContrast)  -->
