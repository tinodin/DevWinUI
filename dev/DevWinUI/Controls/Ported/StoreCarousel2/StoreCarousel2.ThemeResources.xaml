    <!--  StoreGlyphPlay (WinStore.Resources\Themes\Icons.xaml)  -->
    <x:String x:Key="StoreGlyphPlay">&#xE768;</x:String>

    <!--  InverseVisibilityConverter (used by ScreenshotTileContentTemplate)  -->
    <local:BoolToVisibilityConverter
        x:Key="InverseVisibilityConverter"
        FalseValue="Visible"
        TrueValue="Collapsed" />

    <!--  DefaultBackgroundTransition (Resources\ButtonResourceDictionary.xaml)  -->
    <BrushTransition x:Key="DefaultBackgroundTransition" Duration="0:0:0.083" />

    <!--  SubtleIconButtonStyle (ButtonResourceDictionary.xaml)  -->
    <x:Double x:Key="SubtleIconButtonWidth">32</x:Double>
    <x:Double x:Key="SubtleIconButtonHeight">32</x:Double>
    <Thickness x:Key="SubtleIconButtonPadding">0</Thickness>
    <Style x:Key="SubtleIconButtonStyle" TargetType="Button">
        <Setter Property="Width" Value="{StaticResource SubtleIconButtonWidth}" />
        <Setter Property="Height" Value="{StaticResource SubtleIconButtonHeight}" />
        <Setter Property="Padding" Value="{StaticResource SubtleIconButtonPadding}" />
        <Setter Property="Background" Value="{ThemeResource SubtleIconButtonBackground}" />
        <Setter Property="BackgroundSizing" Value="InnerBorderEdge" />
        <Setter Property="Foreground" Value="{ThemeResource SubtleIconButtonForeground}" />
        <Setter Property="BorderBrush" Value="{ThemeResource SubtleIconButtonBorderBrush}" />
        <Setter Property="BorderThickness" Value="{ThemeResource SubtleIconButtonBorderThemeThickness}" />
        <Setter Property="CornerRadius" Value="{ThemeResource ControlCornerRadius}" />
        <Setter Property="UseSystemFocusVisuals" Value="True" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <ContentPresenter
                        x:Name="ContentPresenter"
                        Padding="{TemplateBinding Padding}"
                        HorizontalContentAlignment="Center"
                        VerticalContentAlignment="Center"
                        Background="{TemplateBinding Background}"
                        BackgroundSizing="{TemplateBinding BackgroundSizing}"
                        BorderBrush="{TemplateBinding BorderBrush}"
                        BorderThickness="{TemplateBinding BorderThickness}"
                        Content="{TemplateBinding Content}"
                        ContentTemplate="{TemplateBinding ContentTemplate}"
                        CornerRadius="{TemplateBinding CornerRadius}">
                        <VisualStateManager.VisualStateGroups>
                            <VisualStateGroup x:Name="CommonStates">
                                <VisualState x:Name="Normal" />
                                <VisualState x:Name="PointerOver">
                                    <VisualState.Setters>
                                        <Setter Target="ContentPresenter.Background" Value="{ThemeResource SubtleIconButtonBackgroundPointerOver}" />
                                        <Setter Target="ContentPresenter.BorderBrush" Value="{ThemeResource SubtleIconButtonBorderBrushPointerOver}" />
                                        <Setter Target="ContentPresenter.Foreground" Value="{ThemeResource SubtleIconButtonForegroundPointerOver}" />
                                    </VisualState.Setters>
                                </VisualState>
                                <VisualState x:Name="Pressed">
                                    <VisualState.Setters>
                                        <Setter Target="ContentPresenter.Background" Value="{ThemeResource SubtleIconButtonBackgroundPressed}" />
                                        <Setter Target="ContentPresenter.BorderBrush" Value="{ThemeResource SubtleIconButtonBorderBrushPressed}" />
                                        <Setter Target="ContentPresenter.Foreground" Value="{ThemeResource SubtleIconButtonForegroundPressed}" />
                                    </VisualState.Setters>
                                </VisualState>
                                <VisualState x:Name="Disabled">
                                    <VisualState.Setters>
                                        <Setter Target="ContentPresenter.Background" Value="{ThemeResource SubtleIconButtonBackgroundDisabled}" />
                                        <Setter Target="ContentPresenter.BorderBrush" Value="{ThemeResource SubtleIconButtonBorderBrushDisabled}" />
                                        <Setter Target="ContentPresenter.Foreground" Value="{ThemeResource SubtleIconButtonForegroundDisabled}" />
                                    </VisualState.Setters>
                                </VisualState>
                            </VisualStateGroup>
                        </VisualStateManager.VisualStateGroups>
                    </ContentPresenter>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!--  PlayButton (Resources\ButtonResourceDictionary.xaml): brushes now live in ThemeDictionaries per theme  -->

    <!--  VideoPlayButtonStyle (Resources\ButtonResourceDictionary.xaml)  -->
    <Style x:Key="VideoPlayButtonStyle" TargetType="Button">
        <Setter Property="Background" Value="{ThemeResource PlayButtonBackground}" />
        <Setter Property="BackgroundSizing" Value="InnerBorderEdge" />
        <Setter Property="BorderBrush" Value="{ThemeResource PlayButtonBorderBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="100" />
        <Setter Property="Foreground" Value="{ThemeResource PlayButtonForeground}" />
        <Setter Property="FocusVisualMargin" Value="-3" />
        <Setter Property="FontFamily" Value="{ThemeResource SymbolThemeFontFamily}" />
        <Setter Property="FontWeight" Value="Normal" />
        <Setter Property="FontSize" Value="40" />
        <Setter Property="HorizontalAlignment" Value="Center" />
        <Setter Property="Padding" Value="12" />
        <Setter Property="UseSystemFocusVisuals" Value="True" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <ContentPresenter
                        x:Name="ContentPresenter"
                        Padding="{TemplateBinding Padding}"
                        HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}"
                        VerticalContentAlignment="{TemplateBinding VerticalContentAlignment}"
                        AutomationProperties.AccessibilityView="Raw"
                        Background="{TemplateBinding Background}"
                        BackgroundSizing="{TemplateBinding BackgroundSizing}"
                        BackgroundTransition="{StaticResource DefaultBackgroundTransition}"
                        BorderBrush="{TemplateBinding BorderBrush}"
                        BorderThickness="{TemplateBinding BorderThickness}"
                        Content="{TemplateBinding Content}"
                        ContentTemplate="{TemplateBinding ContentTemplate}"
                        ContentTransitions="{TemplateBinding ContentTransitions}"
                        CornerRadius="{TemplateBinding CornerRadius}">
                        <VisualStateManager.VisualStateGroups>
                            <VisualStateGroup x:Name="CommonStates">
                                <VisualState x:Name="Normal" />
                                <VisualState x:Name="PointerOver">
                                    <Storyboard>
                                        <ObjectAnimationUsingKeyFrames Storyboard.TargetName="ContentPresenter" Storyboard.TargetProperty="Background">
                                            <DiscreteObjectKeyFrame KeyTime="0" Value="{ThemeResource PlayButtonBackgroundHover}" />
                                        </ObjectAnimationUsingKeyFrames>
                                        <ObjectAnimationUsingKeyFrames Storyboard.TargetName="ContentPresenter" Storyboard.TargetProperty="BorderBrush">
                                            <DiscreteObjectKeyFrame KeyTime="0" Value="{ThemeResource PlayButtonBorderBrushHover}" />
                                        </ObjectAnimationUsingKeyFrames>
                                        <ObjectAnimationUsingKeyFrames Storyboard.TargetName="ContentPresenter" Storyboard.TargetProperty="Foreground">
                                            <DiscreteObjectKeyFrame KeyTime="0" Value="{ThemeResource PlayButtonForegroundHover}" />
                                        </ObjectAnimationUsingKeyFrames>
                                    </Storyboard>
                                </VisualState>
                                <VisualState x:Name="Pressed">
                                    <Storyboard>
                                        <ObjectAnimationUsingKeyFrames Storyboard.TargetName="ContentPresenter" Storyboard.TargetProperty="Background">
                                            <DiscreteObjectKeyFrame KeyTime="0" Value="{ThemeResource PlayButtonBackgroundPressed}" />
                                        </ObjectAnimationUsingKeyFrames>
                                        <ObjectAnimationUsingKeyFrames Storyboard.TargetName="ContentPresenter" Storyboard.TargetProperty="BorderBrush">
                                            <DiscreteObjectKeyFrame KeyTime="0" Value="{ThemeResource PlayButtonBorderBrushPressed}" />
                                        </ObjectAnimationUsingKeyFrames>
                                        <ObjectAnimationUsingKeyFrames Storyboard.TargetName="ContentPresenter" Storyboard.TargetProperty="Foreground">
                                            <DiscreteObjectKeyFrame KeyTime="0" Value="{ThemeResource PlayButtonForegroundPressed}" />
                                        </ObjectAnimationUsingKeyFrames>
                                    </Storyboard>
                                </VisualState>
                                <VisualState x:Name="Disabled">
                                    <Storyboard>
                                        <ObjectAnimationUsingKeyFrames Storyboard.TargetName="ContentPresenter" Storyboard.TargetProperty="Background">
                                            <DiscreteObjectKeyFrame KeyTime="0" Value="{ThemeResource PlayButtonBackgroundDisabled}" />
                                        </ObjectAnimationUsingKeyFrames>
                                        <ObjectAnimationUsingKeyFrames Storyboard.TargetName="ContentPresenter" Storyboard.TargetProperty="BorderBrush">
                                            <DiscreteObjectKeyFrame KeyTime="0" Value="{ThemeResource PlayButtonBorderBrushDisabled}" />
                                        </ObjectAnimationUsingKeyFrames>
                                        <ObjectAnimationUsingKeyFrames Storyboard.TargetName="ContentPresenter" Storyboard.TargetProperty="Foreground">
                                            <DiscreteObjectKeyFrame KeyTime="0" Value="{ThemeResource PlayButtonForegroundDisabled}" />
                                        </ObjectAnimationUsingKeyFrames>
                                    </Storyboard>
                                </VisualState>
                            </VisualStateGroup>
                        </VisualStateManager.VisualStateGroups>
                    </ContentPresenter>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!--  HorizontalArrowScrollViewerButtonShadow (Resources\ButtonResourceDictionary.xaml)  -->
    <media:AttachedCardShadow
        x:Key="HorizontalArrowScrollViewerButtonShadow"
        BlurRadius="12"
        CornerRadius="14"
        Opacity="{ThemeResource HorizontalArrowScrollViewerButtonShadowOpacity}" />

    <!--  ArrowScrollViewer (Resources\ButtonResourceDictionary.xaml)  -->
    <x:Double x:Key="ArrowScrollViewerButtonWidth">28</x:Double>
    <x:Double x:Key="ArrowScrollViewerButtonHeight">28</x:Double>
    <CornerRadius x:Key="ArrowScrollViewerButtonCornerRadius">14</CornerRadius>
    <x:Double x:Key="ArrowScrollViewerButtonFontSize">8</x:Double>
    <x:Double x:Key="ArrowScrollViewerButtonFontSizePointerOver">9</x:Double>
    <x:Double x:Key="ArrowScrollViewerButtonFontSizePressed">7</x:Double>
    <Thickness x:Key="ArrowScrollViewerButtonHitTestExpansion">-12</Thickness>
    <!--  ArrowScrollViewer (Resources\ButtonResourceDictionary.xaml): brushes + border thickness now live in ThemeDictionaries per theme  -->
    <x:Double x:Key="ArrowScrollViewerButtonDisabledOpacity">1</x:Double>
    <x:String x:Key="ArrowScrollViewerButtonDisabledVisiblity">Collapsed</x:String>
    <animations:ImplicitAnimationSet x:Key="ArrowScrollViewerButtonImplicitAnimations" />

    <!--  HorizontalArrowScrollViewerButtonStyle (Resources\ButtonResourceDictionary.xaml)  -->
    <Style x:Key="HorizontalArrowScrollViewerButtonStyle" TargetType="Button">
        <Setter Property="IsTabStop" Value="False" />
        <Setter Property="UseSystemFocusVisuals" Value="False" />
        <Setter Property="Width" Value="{ThemeResource ArrowScrollViewerButtonWidth}" />
        <Setter Property="Height" Value="{ThemeResource ArrowScrollViewerButtonHeight}" />
        <Setter Property="Margin" Value="8" />
        <Setter Property="CornerRadius" Value="{ThemeResource ArrowScrollViewerButtonCornerRadius}" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

    <!--  LeftArrowScrollViewerButtonStyle (Resources\ButtonResourceDictionary.xaml)  -->
    <Style
        x:Key="LeftArrowScrollViewerButtonStyle"
        BasedOn="{StaticResource HorizontalArrowScrollViewerButtonStyle}"
        TargetType="Button">
        <Setter Property="HorizontalAlignment" Value="Left" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Grid
                        x:Name="Root"
                        Width="{ThemeResource ArrowScrollViewerButtonWidth}"
                        Height="{ThemeResource ArrowScrollViewerButtonHeight}"
                        ui:Effects.Shadow="{ThemeResource HorizontalArrowScrollViewerButtonShadow}"
                        ui:VisualExtensions.NormalizedCenterPoint="0.5,0.5"
                        CornerRadius="{ThemeResource ArrowScrollViewerButtonCornerRadius}">
                        <animations:Implicit.ShowAnimations>
                            <animations:OpacityAnimation
                                From="0"
                                To="1"
                                Duration="0:0:0.3" />
                            <animations:TranslationAnimation
                                From="-8,0,0"
                                To="0,0,0"
                                Duration="0:0:0.3" />
                        </animations:Implicit.ShowAnimations>
                        <Rectangle Margin="{StaticResource ArrowScrollViewerButtonHitTestExpansion}" Fill="#00FFFFFF" />
                        <Border
                            x:Name="Backplate"
                            animations:Implicit.Animations="{StaticResource ArrowScrollViewerButtonImplicitAnimations}"
                            Background="{ThemeResource ArrowScrollViewerButtonBackground}"
                            BorderBrush="{ThemeResource ArrowScrollViewerButtonBorderBrush}"
                            BorderThickness="{ThemeResource ArrowScrollViewerButtonBorderThemeThickness}"
                            CornerRadius="{TemplateBinding CornerRadius}" />
                        <FontIcon
                            x:Name="Arrow"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            animations:Implicit.Animations="{StaticResource ArrowScrollViewerButtonImplicitAnimations}"
                            FontFamily="{ThemeResource SymbolThemeFontFamily}"
                            FontSize="{StaticResource ArrowScrollViewerButtonFontSize}"
                            Foreground="{ThemeResource ArrowScrollViewerArrowForeground}"
                            Glyph="&#xEDD9;"
                            MirroredWhenRightToLeft="True"
                            UseLayoutRounding="False" />
                        <VisualStateManager.VisualStateGroups>
                            <VisualStateGroup x:Name="CommonStates">
                                <VisualState x:Name="Normal" />
                                <VisualState x:Name="PointerOver">
                                    <Storyboard>
                                        <ObjectAnimationUsingKeyFrames Storyboard.TargetName="Backplate" Storyboard.TargetProperty="Background">
                                            <DiscreteObjectKeyFrame KeyTime="0" Value="{ThemeResource ArrowScrollViewerButtonBackgroundPointerOver}" />
                                        </ObjectAnimationUsingKeyFrames>
                                        <ObjectAnimationUsingKeyFrames Storyboard.TargetName="Backplate" Storyboard.TargetProperty="BorderBrush">
                                            <DiscreteObjectKeyFrame KeyTime="0" Value="{ThemeResource ArrowScrollViewerButtonBorderBrushPointerOver}" />
                                        </ObjectAnimationUsingKeyFrames>
                                        <ObjectAnimationUsingKeyFrames Storyboard.TargetName="Arrow" Storyboard.TargetProperty="Foreground">
                                            <DiscreteObjectKeyFrame KeyTime="0" Value="{ThemeResource ArrowScrollViewerArrowForegroundPointerOver}" />
                                        </ObjectAnimationUsingKeyFrames>
                                        <ObjectAnimationUsingKeyFrames Storyboard.TargetName="Arrow" Storyboard.TargetProperty="FontSize">
                                            <DiscreteObjectKeyFrame KeyTime="0" Value="{StaticResource ArrowScrollViewerButtonFontSizePointerOver}" />
                                        </ObjectAnimationUsingKeyFrames>
                                    </Storyboard>
                                </VisualState>
                                <VisualState x:Name="Pressed">
                                    <Storyboard>
                                        <ObjectAnimationUsingKeyFrames Storyboard.TargetName="Backplate" Storyboard.TargetProperty="Background">
                                            <DiscreteObjectKeyFrame KeyTime="0" Value="{ThemeResource ArrowScrollViewerButtonBackgroundPressed}" />
                                        </ObjectAnimationUsingKeyFrames>
                                        <ObjectAnimationUsingKeyFrames Storyboard.TargetName="Backplate" Storyboard.TargetProperty="BorderBrush">
                                            <DiscreteObjectKeyFrame KeyTime="0" Value="{ThemeResource ArrowScrollViewerButtonBorderBrushPressed}" />
                                        </ObjectAnimationUsingKeyFrames>
                                        <ObjectAnimationUsingKeyFrames Storyboard.TargetName="Arrow" Storyboard.TargetProperty="Foreground">
                                            <DiscreteObjectKeyFrame KeyTime="0" Value="{ThemeResource ArrowScrollViewerArrowForegroundPressed}" />
                                        </ObjectAnimationUsingKeyFrames>
                                        <ObjectAnimationUsingKeyFrames Storyboard.TargetName="Arrow" Storyboard.TargetProperty="FontSize">
                                            <DiscreteObjectKeyFrame KeyTime="0" Value="{StaticResource ArrowScrollViewerButtonFontSizePressed}" />
                                        </ObjectAnimationUsingKeyFrames>
                                    </Storyboard>
                                </VisualState>
                                <VisualState x:Name="Disabled">
                                    <Storyboard>
                                        <ObjectAnimationUsingKeyFrames Storyboard.TargetName="Root" Storyboard.TargetProperty="Visibility">
                                            <DiscreteObjectKeyFrame KeyTime="0" Value="{ThemeResource ArrowScrollViewerButtonDisabledVisiblity}" />
                                        </ObjectAnimationUsingKeyFrames>
                                        <ObjectAnimationUsingKeyFrames Storyboard.TargetName="Backplate" Storyboard.TargetProperty="Opacity">
                                            <DiscreteObjectKeyFrame KeyTime="0" Value="{ThemeResource ArrowScrollViewerButtonDisabledOpacity}" />
                                        </ObjectAnimationUsingKeyFrames>
                                        <ObjectAnimationUsingKeyFrames Storyboard.TargetName="Arrow" Storyboard.TargetProperty="Opacity">
                                            <DiscreteObjectKeyFrame KeyTime="0" Value="{ThemeResource ArrowScrollViewerButtonDisabledOpacity}" />
                                        </ObjectAnimationUsingKeyFrames>
                                    </Storyboard>
                                </VisualState>
                            </VisualStateGroup>
                        </VisualStateManager.VisualStateGroups>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!--  RightArrowScrollViewerButtonStyle (Resources\ButtonResourceDictionary.xaml)  -->
