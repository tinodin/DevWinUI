    <!--  DefaultTileImageStyle (UX\Controls\TileImage.xaml)  -->
    <Style x:Key="DefaultTileImageStyle" TargetType="local:TileImage">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="local:TileImage">
                    <Grid x:Name="RootGrid" Background="{TemplateBinding Background}">
                        <Rectangle
                            x:Name="BackgroundElement"
                            Fill="{TemplateBinding Background}"
                            IsHitTestVisible="False"
                            Opacity="0" />
                        <Image
                            x:Name="MainImage"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            Stretch="{TemplateBinding Stretch}" />
                        <VisualStateManager.VisualStateGroups>
                            <VisualStateGroup x:Name="BackplateStates">
                                <VisualState x:Name="DefaultBackplateVisualState">
                                    <VisualState.Setters>
                                        <Setter Target="BackgroundElement.Opacity" Value="0" />
                                    </VisualState.Setters>
                                </VisualState>
                                <VisualState x:Name="ColoredBackplateVisualState">
                                    <VisualState.Setters>
                                        <Setter Target="BackgroundElement.Opacity" Value="1" />
                                    </VisualState.Setters>
                                </VisualState>
                            </VisualStateGroup>
                        </VisualStateManager.VisualStateGroups>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style BasedOn="{StaticResource DefaultTileImageStyle}" TargetType="local:TileImage" />

    <!--  ScreenshotTileContentTemplate (UX\Controls\Tiles\TileDataTemplates.xaml)  -->
    <DataTemplate x:Key="ScreenshotTileContentTemplate">
        <Grid x:Name="TileImageRootGrid">
            <controls:ConstrainedBox x:Name="Shimmer" AspectRatio="16:9">
                <controls:ConstrainedBox.Visibility>
                    <Binding
                        Converter="{StaticResource InverseVisibilityConverter}"
                        ElementName="TileImageControl"
                        Path="ImageProcessed" />
                </controls:ConstrainedBox.Visibility>
                <local:Shimmer />
            </controls:ConstrainedBox>
            <local:TileImage
                x:Name="TileImageControl"
                ImageItem="{Binding}"
                RequestedImageHeight="316"
                ShowBackgroundColor="False">
                <interactivity:Interaction.Behaviors>
                    <local:ViewDisplayedBehavior />
                </interactivity:Interaction.Behaviors>
            </local:TileImage>
        </Grid>
    </DataTemplate>

    <!--  AgeRestricted tile brushes now live in ThemeDictionaries per theme (WinStore.Resources\Themes\Dark/Light/HighContrast.xaml)  -->

    <Style x:Key="ImageContentControlStyle" TargetType="ContentControl">
        <Setter Property="IsTabStop" Value="False" />
        <Setter Property="CornerRadius" Value="{StaticResource CardCornerRadius}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ContentControl">
                    <Grid>
                        <Rectangle Fill="{TemplateBinding Background}" IsHitTestVisible="False" />
                        <ContentPresenter
                            Margin="{TemplateBinding Padding}"
                            Content="{TemplateBinding Content}"
                            ContentTemplate="{TemplateBinding ContentTemplate}"
                            ContentTransitions="{TemplateBinding ContentTransitions}" />
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!--  ScreenshotMosaicTileButtonStyle (UX\\Controls\\Tiles\\TileDataTemplates.xaml)  -->
    <Style x:Key="ScreenshotMosaicTileButtonStyle" TargetType="local:ResponsiveTileButton">
        <Setter Property="MinHeight" Value="0" />
        <Setter Property="MinWidth" Value="0" />
        <Setter Property="Background" Value="#00FFFFFF" />
        <Setter Property="Foreground" Value="{ThemeResource DefaultTextForegroundThemeBrush}" />
        <Setter Property="FontWeight" Value="Normal" />
        <Setter Property="VerticalAlignment" Value="Stretch" />
        <Setter Property="HorizontalAlignment" Value="Stretch" />
        <Setter Property="UseSystemFocusVisuals" Value="False" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="local:ResponsiveTileButton">
                    <Grid
                        x:Name="_rootGrid"
                        Padding="2"
                        Background="{TemplateBinding Background}">
                        <ContentPresenter
                            x:Name="_contentPresenter"
                            AutomationProperties.AccessibilityView="Raw"
                            Background="{ThemeResource QuickLinkMosaicItemBackgroundBrush}"
                            Content="{TemplateBinding Content}"
                            ContentTemplate="{TemplateBinding ContentTemplate}"
                            Foreground="{TemplateBinding Foreground}" />
                        <Border
                            x:Name="_focusRect"
                            Margin="-2"
                            BorderBrush="{ThemeResource FocusRectOuterBorderBrush}"
                            BorderThickness="2"
                            Opacity="0">
                            <Border.Child>
                                <Border BorderBrush="{ThemeResource FocusRectInnerBorderBrush}" BorderThickness="1" />
                            </Border.Child>
                        </Border>
                        <VisualStateManager.VisualStateGroups>
                            <VisualStateGroup x:Name="CommonStates">
                                <VisualState x:Name="Normal" />
                                <VisualState x:Name="PointerOver">
                                    <VisualState.Setters>
                                        <Setter Target="_rootGrid.Background" Value="{ThemeResource ItemPointerOverBackgroundBrush}" />
                                    </VisualState.Setters>
                                </VisualState>
                                <VisualState x:Name="Pressed">
                                    <VisualState.Setters>
                                        <Setter Target="_rootGrid.Background" Value="{ThemeResource ItemPressedBackgroundBrush}" />
                                    </VisualState.Setters>
                                </VisualState>
                                <VisualState x:Name="Disabled" />
                            </VisualStateGroup>
                            <VisualStateGroup x:Name="FocusStates">
                                <VisualState x:Name="Focused">
                                    <VisualState.Setters>
                                        <Setter Target="_focusRect.Opacity" Value="1" />
                                    </VisualState.Setters>
                                </VisualState>
                                <VisualState x:Name="Unfocused" />
                                <VisualState x:Name="PointerFocused" />
                            </VisualStateGroup>
                        </VisualStateManager.VisualStateGroups>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!--  AgeRestrictedDataTemplate (UX\\Controls\\Tiles\\TileDataTemplates.xaml)  -->
    <DataTemplate x:Key="AgeRestrictedDataTemplate">
        <controls:ConstrainedBox AspectRatio="16:9">
            <Grid>
                <local:Shimmer x:Name="Shimmer">
                    <local:Shimmer.Visibility>
                        <Binding
                            Converter="{StaticResource InverseVisibilityConverter}"
                            ElementName="TileImageControl"
                            Path="ImageProcessed" />
                    </local:Shimmer.Visibility>
                </local:Shimmer>
                <local:TileImage
                    x:Name="TileImageControl"
                    ImageItem="{Binding}"
                    RequestedImageHeight="316"
                    ShowBackgroundColor="False">
                    <interactivity:Interaction.Behaviors>
                        <local:ViewDisplayedBehavior />
                    </interactivity:Interaction.Behaviors>
                </local:TileImage>
                <Border Background="{ThemeResource AcrylicInAppFillColorDefaultBrush}" />
                <StackPanel Margin="8,0" VerticalAlignment="Center">
                    <TextBlock Style="{StaticResource SubtitleTextBlockStyle}" TextAlignment="Center" />
                    <TextBlock
                        MaxWidth="400"
                        Style="{StaticResource BodyTextBlockStyle}"
                        TextAlignment="Center"
                        TextWrapping="WrapWholeWords" />
                    <Button
                        MinWidth="160"
                        Margin="0,12,0,0"
                        HorizontalAlignment="Center" />
                </StackPanel>
            </Grid>
        </controls:ConstrainedBox>
    </DataTemplate>


    <!--
        StaticListViewStyle (Resources\DefaultResourceDictionary.xaml).
        The Store wraps the ItemsPresenter in a StaticListItemsPresenterWrapper
        (keeps containers alive for recycling); WinUI 3 has no such control, so
        the wrapper is omitted and a plain ItemsPresenter is used.
    -->
    <Style x:Key="StaticListViewStyle" TargetType="local:NoPointerWheelListView">
        <Setter Property="HorizontalAlignment" Value="Stretch" />
        <Setter Property="IsItemClickEnabled" Value="True" />
        <Setter Property="IsTabStop" Value="False" />
        <Setter Property="SelectionMode" Value="Single" />
        <Setter Property="ShowsScrollingPlaceholders" Value="False" />
        <Setter Property="TabNavigation" Value="Once" />
        <Setter Property="VerticalAlignment" Value="Stretch" />
        <Setter Property="VerticalContentAlignment" Value="Stretch" />
        <Setter Property="ItemContainerTransitions">
            <Setter.Value>
                <TransitionCollection />
            </Setter.Value>
        </Setter>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ListView">
                    <Border
                        Background="{TemplateBinding Background}"
                        BorderBrush="{TemplateBinding BorderBrush}"
                        BorderThickness="{TemplateBinding BorderThickness}">
                        <ScrollViewer
                            x:Name="ScrollViewer"
                            AutomationProperties.AccessibilityView="Raw"
                            BringIntoViewOnFocusChange="{TemplateBinding ScrollViewer.BringIntoViewOnFocusChange}"
                            HorizontalScrollBarVisibility="{TemplateBinding ScrollViewer.HorizontalScrollBarVisibility}"
                            HorizontalScrollMode="{TemplateBinding ScrollViewer.HorizontalScrollMode}"
                            IsDeferredScrollingEnabled="{TemplateBinding ScrollViewer.IsDeferredScrollingEnabled}"
                            IsHorizontalRailEnabled="{TemplateBinding ScrollViewer.IsHorizontalRailEnabled}"
                            IsHorizontalScrollChainingEnabled="{TemplateBinding ScrollViewer.IsHorizontalScrollChainingEnabled}"
                            IsVerticalRailEnabled="{TemplateBinding ScrollViewer.IsVerticalRailEnabled}"
                            IsVerticalScrollChainingEnabled="{TemplateBinding ScrollViewer.IsVerticalScrollChainingEnabled}"
                            TabNavigation="{TemplateBinding TabNavigation}"
                            VerticalScrollBarVisibility="{TemplateBinding ScrollViewer.VerticalScrollBarVisibility}"
                            VerticalScrollMode="{TemplateBinding ScrollViewer.VerticalScrollMode}"
                            ZoomMode="{TemplateBinding ScrollViewer.ZoomMode}">
                            <Border Background="#00FFFFFF">
                                <ItemsPresenter
                                    Padding="{TemplateBinding Padding}"
                                    Footer="{TemplateBinding Footer}"
                                    FooterTemplate="{TemplateBinding FooterTemplate}"
                                    FooterTransitions="{TemplateBinding FooterTransitions}"
                                    Header="{TemplateBinding Header}"
                                    HeaderTemplate="{TemplateBinding HeaderTemplate}"
                                    HeaderTransitions="{TemplateBinding HeaderTransitions}" />
                            </Border>
                        </ScrollViewer>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!--  CardCornerRadius (Resources\CardResourceDictionary.xaml)  -->
    <CornerRadius x:Key="CardCornerRadius">8</CornerRadius>

    <!--  DefaultListViewBaseItemContainerStyle (App.xaml)  -->
    <Style x:Key="DefaultListViewBaseItemContainerStyle" TargetType="primitives:SelectorItem">
        <Setter Property="Margin" Value="0" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="MinWidth" Value="0" />
        <Setter Property="MinHeight" Value="0" />
        <Setter Property="Background" Value="#00FFFFFF" />
        <Setter Property="TabNavigation" Value="Local" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="VerticalContentAlignment" Value="Stretch" />
        <Setter Property="UseSystemFocusVisuals" Value="True" />
    </Style>

    <!--  ScreenshotListViewBaseItemContainerStyle (App.xaml)  -->
    <Style
        x:Key="ScreenshotListViewBaseItemContainerStyle"
        BasedOn="{StaticResource DefaultListViewBaseItemContainerStyle}"
        TargetType="ListViewItem">
        <Setter Property="BorderBrush" Value="#00FFFFFF" />
        <Setter Property="CornerRadius" Value="{StaticResource CardCornerRadius}" />
        <Setter Property="Margin" Value="4,0" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ListViewItem">
                    <Grid x:Name="ContentContainer" CornerRadius="{TemplateBinding CornerRadius}">
                        <ContentPresenter
                            x:Name="ContentPresenter"
                            Margin="{TemplateBinding Padding}"
                            HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                            VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                            ContentTransitions="{TemplateBinding ContentTransitions}"
                            Control.IsTemplateFocusTarget="True"
                            CornerRadius="{TemplateBinding CornerRadius}" />
                        <Border
                            x:Name="BackgroundBorder"
                            Background="{TemplateBinding Background}"
                            BackgroundTransition="{StaticResource DefaultBackgroundTransition}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{ThemeResource ItemHighContrastPointerOverBorderThickness}"
                            IsHitTestVisible="False" />
                        <VisualStateManager.VisualStateGroups>
                            <VisualStateGroup x:Name="CommonStates">
                                <VisualState x:Name="Normal" />
                                <VisualState x:Name="PointerOver">
                                    <VisualState.Setters>
                                        <Setter Target="BackgroundBorder.Background" Value="#33F6F6F6" />
                                        <Setter Target="BackgroundBorder.BorderBrush" Value="{ThemeResource ItemHighContrastPointerOverBorderBrush}" />
                                    </VisualState.Setters>
                                </VisualState>
                                <VisualState x:Name="Pressed">
                                    <VisualState.Setters>
                                        <Setter Target="BackgroundBorder.Background" Value="#66F6F6F6" />
                                        <Setter Target="BackgroundBorder.BorderBrush" Value="{ThemeResource ItemHighContrastPressedBorderBrush}" />
                                    </VisualState.Setters>
                                </VisualState>
                                <VisualState x:Name="Disabled">
                                    <VisualState.Setters>
                                        <Setter Target="ContentPresenter.Opacity" Value="{ThemeResource ListViewItemDisabledThemeOpacity}" />
                                    </VisualState.Setters>
                                </VisualState>
                            </VisualStateGroup>
                        </VisualStateManager.VisualStateGroups>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!--  DefaultScreenshotContainerStyle (App.xaml)  -->
    <Style
        x:Key="DefaultScreenshotContainerStyle"
        BasedOn="{StaticResource ScreenshotListViewBaseItemContainerStyle}"
        TargetType="ListViewItem">
        <Setter Property="Margin" Value="12,0" />
    </Style>

</ResourceDictionary>
