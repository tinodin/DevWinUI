            <StaticResource x:Key="ArrowScrollViewerButtonBackground" ResourceKey="AcrylicInAppFillColorDefaultBrush" />
            <StaticResource x:Key="ArrowScrollViewerButtonBackgroundPointerOver" ResourceKey="AcrylicInAppFillColorDefaultBrush" />
            <StaticResource x:Key="ArrowScrollViewerButtonBackgroundPressed" ResourceKey="AcrylicInAppFillColorDefaultBrush" />
