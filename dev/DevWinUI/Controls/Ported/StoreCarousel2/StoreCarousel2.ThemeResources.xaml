            <StaticResource x:Key="PlayButtonForegroundPressed" ResourceKey="SystemControlHighlightBaseHighBrush" />
            <StaticResource x:Key="PlayButtonForegroundHover" ResourceKey="SystemControlHighlightBaseHighBrush" />
            <StaticResource x:Key="PlayButtonForegroundDisabled" ResourceKey="SystemControlDisabledBaseMediumLowBrush" />
            <StaticResource x:Key="PlayButtonBorderBrush" ResourceKey="SystemControlForegroundTransparentBrush" />
            <StaticResource x:Key="PlayButtonBorderBrushPressed" ResourceKey="SystemColorHighlightTextColorBrush" />
            <StaticResource x:Key="PlayButtonBorderBrushHover" ResourceKey="SystemColorHighlightColorBrush" />
            <StaticResource x:Key="PlayButtonBorderBrushDisabled" ResourceKey="SystemControlDisabledTransparentBrush" />
            <StaticResource x:Key="PlayButtonBackground" ResourceKey="SystemControlBackgroundBaseLowBrush" />
            <StaticResource x:Key="PlayButtonBackgroundPressed" ResourceKey="SystemColorHighlightTextColorBrush" />
            <StaticResource x:Key="PlayButtonBackgroundHover" ResourceKey="SystemColorHighlightTextColorBrush" />
            <StaticResource x:Key="PlayButtonBackgroundDisabled" ResourceKey="SystemControlBackgroundBaseLowBrush" />
            <!--  ArrowScrollViewer (Resources\ButtonResourceDictionary.xaml, HighContrast)  -->
            <Thickness x:Key="ArrowScrollViewerButtonBorderThemeThickness">1</Thickness>
            <StaticResource x:Key="ArrowScrollViewerButtonBackground" ResourceKey="AcrylicInAppFillColorDefaultBrush" />
            <StaticResource x:Key="ArrowScrollViewerButtonBackgroundPointerOver" ResourceKey="AcrylicInAppFillColorDefaultBrush" />
            <StaticResource x:Key="ArrowScrollViewerButtonBackgroundPressed" ResourceKey="AcrylicInAppFillColorDefaultBrush" />
            <StaticResource x:Key="ArrowScrollViewerButtonBorderBrush" ResourceKey="SystemControlForegroundTransparentBrush" />
            <StaticResource x:Key="ArrowScrollViewerButtonBorderBrushPointerOver" ResourceKey="SystemControlForegroundTransparentBrush" />
            <StaticResource x:Key="ArrowScrollViewerButtonBorderBrushPressed" ResourceKey="SystemControlForegroundTransparentBrush" />
            <StaticResource x:Key="ArrowScrollViewerArrowForeground" ResourceKey="SystemControlForegroundAltMediumHighBrush" />
            <StaticResource x:Key="ArrowScrollViewerArrowForegroundPointerOver" ResourceKey="SystemControlHighlightAltAltMediumHighBrush" />
            <StaticResource x:Key="ArrowScrollViewerArrowForegroundPressed" ResourceKey="SystemControlHighlightAltAltMediumHighBrush" />
            <!--  AgeRestricted tile (WinStore.Resources\Themes\HighContrast.xaml)  -->
            <SolidColorBrush
                x:Key="ImageOpacityOverlayBackgroundBrush"
                Opacity="0.4"
                Color="#FF000000" />
            <SolidColorBrush x:Key="WhiteTextForegroundBrush" Color="{ThemeResource SystemColorWindowTextColor}" />
            <SolidColorBrush x:Key="HighContrastBackgroundBrush" Color="{ThemeResource SystemColorWindowColor}" />
        </ResourceDictionary>

        <ResourceDictionary x:Key="Light">
            <AcrylicBrush
                x:Key="AcrylicInAppFillColorThinBrush"
                FallbackColor="#99D3D3D3"
                TintColor="#FFD3D3D3"
                TintLuminosityOpacity="0.44"
                TintOpacity="0" />
            <StaticResource x:Key="ScreenshotsCarouselPanelBackgroundBrush" ResourceKey="SolidBackgroundFillColorQuarternaryBrush" />
            <StaticResource x:Key="ScreenshotsCarouselPanelBorderBrush" ResourceKey="CardStrokeColorDefaultBrush" />
            <StaticResource x:Key="ScreenshotsCarouselViewerBackdropBrush" ResourceKey="AcrylicInAppFillColorThinBrush" />
            <x:Double x:Key="HorizontalArrowScrollViewerButtonShadowOpacity">0.1</x:Double>
            <SolidColorBrush x:Key="ItemHighContrastPressedBorderBrush" Color="#00FFFFFF" />
            <Thickness x:Key="ItemHighContrastPointerOverBorderThickness">0</Thickness>
            <SolidColorBrush x:Key="ItemHighContrastPointerOverBorderBrush" Color="#00FFFFFF" />
            <!--  ResponsiveTileButton (WinStore.Resources\Themes\Light.xaml)  -->
            <Color x:Key="ImagePlaceholderColor">#FFE4E4E4</Color>
            <SolidColorBrush x:Key="ItemPressedBackgroundBrush" Color="#33000000" />
            <SolidColorBrush x:Key="ItemPointerOverBackgroundBrush" Color="#19000000" />
            <SolidColorBrush x:Key="QuickLinkMosaicItemBackgroundBrush" Color="{StaticResource ImagePlaceholderColor}" />
            <SolidColorBrush x:Key="FocusRectOuterBorderBrush" Color="{StaticResource SystemBaseHighColor}" />
            <SolidColorBrush x:Key="FocusRectInnerBorderBrush" Color="{StaticResource SystemAltMediumColor}" />
            <SolidColorBrush x:Key="DefaultTextForegroundThemeBrush" Color="{StaticResource SystemBaseHighColor}" />
            <!--  SubtleIconButton (Resources\ButtonResourceDictionary.xaml, Light)  -->
            <Thickness x:Key="SubtleIconButtonBorderThemeThickness">1</Thickness>
            <StaticResource x:Key="SubtleIconButtonBackground" ResourceKey="ControlFillColorTransparentBrush" />
            <StaticResource x:Key="SubtleIconButtonBackgroundPointerOver" ResourceKey="SubtleFillColorSecondaryBrush" />
            <StaticResource x:Key="SubtleIconButtonBackgroundPressed" ResourceKey="SubtleFillColorTertiaryBrush" />
            <StaticResource x:Key="SubtleIconButtonBackgroundDisabled" ResourceKey="ControlFillColorTransparentBrush" />
            <StaticResource x:Key="SubtleIconButtonForeground" ResourceKey="TextFillColorPrimaryBrush" />
            <StaticResource x:Key="SubtleIconButtonForegroundPointerOver" ResourceKey="TextFillColorPrimaryBrush" />
            <StaticResource x:Key="SubtleIconButtonForegroundPressed" ResourceKey="TextFillColorSecondaryBrush" />
            <StaticResource x:Key="SubtleIconButtonForegroundDisabled" ResourceKey="TextFillColorDisabledBrush" />
            <StaticResource x:Key="SubtleIconButtonBorderBrush" ResourceKey="ControlFillColorTransparentBrush" />
            <StaticResource x:Key="SubtleIconButtonBorderBrushPointerOver" ResourceKey="SubtleFillColorSecondaryBrush" />
            <StaticResource x:Key="SubtleIconButtonBorderBrushPressed" ResourceKey="SubtleFillColorTertiaryBrush" />
            <StaticResource x:Key="SubtleIconButtonBorderBrushDisabled" ResourceKey="ControlFillColorTransparentBrush" />
            <!--  PlayButton (Resources\ButtonResourceDictionary.xaml, Light)  -->
            <StaticResource x:Key="PlayButtonForeground" ResourceKey="TextFillColorPrimaryBrush" />
            <StaticResource x:Key="PlayButtonForegroundPressed" ResourceKey="TextFillColorTertiaryBrush" />
            <StaticResource x:Key="PlayButtonForegroundHover" ResourceKey="TextFillColorSecondaryBrush" />
            <StaticResource x:Key="PlayButtonForegroundDisabled" ResourceKey="TextFillColorDisabledBrush" />
            <StaticResource x:Key="PlayButtonBorderBrush" ResourceKey="ControlStrokeColorDefaultBrush" />
            <StaticResource x:Key="PlayButtonBorderBrushPressed" ResourceKey="ControlStrokeColorOnAccentDefaultBrush" />
            <StaticResource x:Key="PlayButtonBorderBrushHover" ResourceKey="ControlStrokeColorSecondaryBrush" />
            <StaticResource x:Key="PlayButtonBorderBrushDisabled" ResourceKey="ControlStrokeColorOnAccentDisabledBrush" />
            <StaticResource x:Key="PlayButtonBackground" ResourceKey="ControlOnImageFillColorDefaultBrush" />
            <StaticResource x:Key="PlayButtonBackgroundPressed" ResourceKey="ControlOnImageFillColorTertiaryBrush" />
            <StaticResource x:Key="PlayButtonBackgroundHover" ResourceKey="ControlOnImageFillColorSecondaryBrush" />
            <StaticResource x:Key="PlayButtonBackgroundDisabled" ResourceKey="ControlOnImageFillColorDisabledBrush" />
            <!--  ArrowScrollViewer (Resources\ButtonResourceDictionary.xaml, Light)  -->
            <Thickness x:Key="ArrowScrollViewerButtonBorderThemeThickness">0</Thickness>
            <StaticResource x:Key="ArrowScrollViewerButtonBackground" ResourceKey="AcrylicInAppFillColorDefaultBrush" />
            <StaticResource x:Key="ArrowScrollViewerButtonBackgroundPointerOver" ResourceKey="AcrylicInAppFillColorDefaultBrush" />
            <StaticResource x:Key="ArrowScrollViewerButtonBackgroundPressed" ResourceKey="AcrylicInAppFillColorDefaultBrush" />
            <StaticResource x:Key="ArrowScrollViewerButtonBorderBrush" ResourceKey="ControlStrokeColorDefaultBrush" />
            <StaticResource x:Key="ArrowScrollViewerButtonBorderBrushPointerOver" ResourceKey="ControlStrokeColorDefaultBrush" />
            <StaticResource x:Key="ArrowScrollViewerButtonBorderBrushPressed" ResourceKey="ControlStrokeColorDefaultBrush" />
            <StaticResource x:Key="ArrowScrollViewerArrowForeground" ResourceKey="ControlStrongFillColorDefaultBrush" />
            <StaticResource x:Key="ArrowScrollViewerArrowForegroundPointerOver" ResourceKey="TextFillColorSecondaryBrush" />
            <StaticResource x:Key="ArrowScrollViewerArrowForegroundPressed" ResourceKey="TextFillColorSecondaryBrush" />
            <!--  AgeRestricted tile (WinStore.Resources\Themes\Light.xaml)  -->
            <SolidColorBrush
                x:Key="ImageOpacityOverlayBackgroundBrush"
                Opacity="0.4"
                Color="#FF000000" />
            <SolidColorBrush x:Key="WhiteTextForegroundBrush" Color="{StaticResource SystemChromeWhiteColor}" />
