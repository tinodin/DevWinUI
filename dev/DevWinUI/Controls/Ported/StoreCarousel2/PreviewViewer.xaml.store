<OverlayPopupBase
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:animations="using:CommunityToolkit.WinUI.Animations"
    xmlns:behaviors="using:WinStore.UX.Behaviors"
    xmlns:common="using:WinStore.UX.Common"
    xmlns:controls="using:WinStore.UX.Controls"
    xmlns:coreHelpers="using:WinStore.Core.Helpers"
    xmlns:interactivity="using:Microsoft.Xaml.Interactivity"
    xmlns:local="using:WinStore.UX.Controls.PDP"
    xmlns:pdp="using:WinStore.ViewModels.PDP"
    xmlns:tiles="using:WinStore.UX.Controls.Tiles"
    xmlns:ui="using:CommunityToolkit.WinUI"
    xmlns:viewModels="using:WinStore.ViewModels"
    xmlns:wctcontrols="using:CommunityToolkit.WinUI.Controls"
    x:Class="WinStore.UX.Controls.PDP.PreviewViewer"
    TabNavigation="Cycle">
    <OverlayPopupBase.Resources>
        <DataTemplate x:Key="VideoPlayerTemplate">
            <DataTemplate.Template>
                <PreviewViewerVideoItem>
                    <PreviewViewerVideoItem.Behaviors>
                        <ViewDisplayedBehavior />
                    </PreviewViewerVideoItem.Behaviors>
                </PreviewViewerVideoItem>
            </DataTemplate.Template>
        </DataTemplate>
        <DataTemplate x:Key="FlipViewScreenshotTemplate">
            <DataTemplate.Template>
                <PreviewViewerScreenshotItem>
                    <PreviewViewerScreenshotItem.Behaviors>
                        <ViewDisplayedBehavior />
                    </PreviewViewerScreenshotItem.Behaviors>
                </PreviewViewerScreenshotItem>
            </DataTemplate.Template>
        </DataTemplate>
        <ScreenshotDataTemplateSelector x:Key="FlipViewDataTemplateSelector" AgeRestrictedDataTemplate="{StaticResource AgeRestrictedDataTemplate}" ScreenshotDataTemplate="{StaticResource FlipViewScreenshotTemplate}" VideoPlayerTemplate="{StaticResource VideoPlayerTemplate}" />
        <Style x:Key="CircleArrowScrollViewerButtonFlipViewStyle" TargetType="FlipView">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="FlipView">
                        <ControlTemplate.Template>
                            <Grid Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="{TemplateBinding CornerRadius}">
                                <Grid.Resources>
                                    <ControlTemplate x:Key="VerticalPreviousTemplate" TargetType="Button">
                                        <ControlTemplate.Template>
                                            <Border x:Name="Root" Background="{ThemeResource FlipViewNextPreviousButtonBackground}" BorderBrush="{ThemeResource FlipViewNextPreviousButtonBorderBrush}" BorderThickness="{ThemeResource FlipViewButtonBorderThemeThickness}" CornerRadius="{TemplateBinding CornerRadius}">
                                                <Border.VisualStateGroups>
                                                    <VisualStateGroup x:Name="CommonStates">
                                                        <VisualStateGroup.States>
                                                            <VisualState x:Name="Normal" />
                                                            <VisualState x:Name="PointerOver">
                                                                <VisualState.Storyboard>
                                                                    <Storyboard>
                                                                        <Storyboard.Children>
                                                                            <ObjectAnimationUsingKeyFrames TargetName="Root" TargetProperty="Background">
                                                                                <ObjectAnimationUsingKeyFrames.KeyFrames>
                                                                                    <DiscreteObjectKeyFrame KeyTime="0" Value="{ThemeResource FlipViewNextPreviousButtonBackgroundPointerOver}" />
                                                                                </ObjectAnimationUsingKeyFrames.KeyFrames>
                                                                            </ObjectAnimationUsingKeyFrames>
                                                                            <ObjectAnimationUsingKeyFrames TargetName="Root" TargetProperty="BorderBrush">
                                                                                <ObjectAnimationUsingKeyFrames.KeyFrames>
                                                                                    <DiscreteObjectKeyFrame KeyTime="0" Value="{ThemeResource FlipViewNextPreviousButtonBorderBrushPointerOver}" />
                                                                                </ObjectAnimationUsingKeyFrames.KeyFrames>
                                                                            </ObjectAnimationUsingKeyFrames>
                                                                            <ObjectAnimationUsingKeyFrames TargetName="Arrow" TargetProperty="Foreground">
                                                                                <ObjectAnimationUsingKeyFrames.KeyFrames>
                                                                                    <DiscreteObjectKeyFrame KeyTime="0" Value="{ThemeResource FlipViewNextPreviousArrowForegroundPointerOver}" />
                                                                                </ObjectAnimationUsingKeyFrames.KeyFrames>
                                                                            </ObjectAnimationUsingKeyFrames>
                                                                        </Storyboard.Children>
                                                                    </Storyboard>
                                                                </VisualState.Storyboard>
                                                            </VisualState>
                                                            <VisualState x:Name="Pressed">
                                                                <VisualState.Storyboard>
                                                                    <Storyboard>
                                                                        <Storyboard.Children>
                                                                            <ObjectAnimationUsingKeyFrames TargetName="Root" TargetProperty="Background">
                                                                                <ObjectAnimationUsingKeyFrames.KeyFrames>
                                                                                    <DiscreteObjectKeyFrame KeyTime="0" Value="{ThemeResource FlipViewNextPreviousButtonBackgroundPressed}" />
                                                                                </ObjectAnimationUsingKeyFrames.KeyFrames>
                                                                            </ObjectAnimationUsingKeyFrames>
                                                                            <ObjectAnimationUsingKeyFrames TargetName="Root" TargetProperty="BorderBrush">
                                                                                <ObjectAnimationUsingKeyFrames.KeyFrames>
                                                                                    <DiscreteObjectKeyFrame KeyTime="0" Value="{ThemeResource FlipViewNextPreviousButtonBorderBrushPressed}" />
                                                                                </ObjectAnimationUsingKeyFrames.KeyFrames>
                                                                            </ObjectAnimationUsingKeyFrames>
                                                                            <ObjectAnimationUsingKeyFrames TargetName="Arrow" TargetProperty="Foreground">
                                                                                <ObjectAnimationUsingKeyFrames.KeyFrames>
                                                                                    <DiscreteObjectKeyFrame KeyTime="0" Value="{ThemeResource FlipViewNextPreviousArrowForegroundPressed}" />
                                                                                </ObjectAnimationUsingKeyFrames.KeyFrames>
                                                                            </ObjectAnimationUsingKeyFrames>
                                                                            <DoubleAnimationUsingKeyFrames RepeatBehavior="Forever" TargetName="Arrow" TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)">
                                                                                <DoubleAnimationUsingKeyFrames.KeyFrames>
                                                                                    <DiscreteDoubleKeyFrame KeyTime="0.016" Value="{ThemeResource FlipViewButtonScalePressed}" />
                                                                                    <DiscreteDoubleKeyFrame KeyTime="30" Value="{ThemeResource FlipViewButtonScalePressed}" />
                                                                                </DoubleAnimationUsingKeyFrames.KeyFrames>
                                                                            </DoubleAnimationUsingKeyFrames>
                                                                            <DoubleAnimationUsingKeyFrames RepeatBehavior="Forever" TargetName="Arrow" TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)">
                                                                                <DoubleAnimationUsingKeyFrames.KeyFrames>
                                                                                    <DiscreteDoubleKeyFrame KeyTime="0.016" Value="{ThemeResource FlipViewButtonScalePressed}" />
                                                                                    <DiscreteDoubleKeyFrame KeyTime="30" Value="{ThemeResource FlipViewButtonScalePressed}" />
                                                                                </DoubleAnimationUsingKeyFrames.KeyFrames>
                                                                            </DoubleAnimationUsingKeyFrames>
                                                                        </Storyboard.Children>
                                                                    </Storyboard>
                                                                </VisualState.Storyboard>
                                                            </VisualState>
                                                        </VisualStateGroup.States>
                                                    </VisualStateGroup>
                                                </Border.VisualStateGroups>
                                                <Border.Child>
                                                    <FontIcon x:Name="Arrow"
                                                        HorizontalAlignment="Center"
                                                        VerticalAlignment="Center"
                                                        FontFamily="{ThemeResource SymbolThemeFontFamily}"
                                                        FontSize="{ThemeResource FlipViewButtonFontSize}"
                                                        Foreground="{ThemeResource FlipViewNextPreviousArrowForeground}"
                                                        Glyph=""
                                                        RenderTransformOrigin="0.5, 0.5"
                                                        UseLayoutRounding="False">
                                                        <FontIcon.RenderTransform>
                                                            <ScaleTransform x:Name="ScaleTransform" ScaleX="1" ScaleY="1" />
                                                        </FontIcon.RenderTransform>
                                                    </FontIcon>
                                                </Border.Child>
                                            </Border>
                                        </ControlTemplate.Template>
                                    </ControlTemplate>
                                    <ControlTemplate x:Key="VerticalNextTemplate" TargetType="Button">
                                        <ControlTemplate.Template>
                                            <Border x:Name="Root" Background="{ThemeResource FlipViewNextPreviousButtonBackground}" BorderBrush="{ThemeResource FlipViewNextPreviousButtonBorderBrush}" BorderThickness="{ThemeResource FlipViewButtonBorderThemeThickness}" CornerRadius="{TemplateBinding CornerRadius}">
                                                <Border.VisualStateGroups>
                                                    <VisualStateGroup x:Name="CommonStates">
                                                        <VisualStateGroup.States>
                                                            <VisualState x:Name="Normal" />
                                                            <VisualState x:Name="PointerOver">
                                                                <VisualState.Storyboard>
                                                                    <Storyboard>
                                                                        <Storyboard.Children>
                                                                            <ObjectAnimationUsingKeyFrames TargetName="Root" TargetProperty="Background">
                                                                                <ObjectAnimationUsingKeyFrames.KeyFrames>
                                                                                    <DiscreteObjectKeyFrame KeyTime="0" Value="{ThemeResource FlipViewNextPreviousButtonBackgroundPointerOver}" />
                                                                                </ObjectAnimationUsingKeyFrames.KeyFrames>
                                                                            </ObjectAnimationUsingKeyFrames>
                                                                            <ObjectAnimationUsingKeyFrames TargetName="Root" TargetProperty="BorderBrush">
                                                                                <ObjectAnimationUsingKeyFrames.KeyFrames>
                                                                                    <DiscreteObjectKeyFrame KeyTime="0" Value="{ThemeResource FlipViewNextPreviousButtonBorderBrushPointerOver}" />
                                                                                </ObjectAnimationUsingKeyFrames.KeyFrames>
                                                                            </ObjectAnimationUsingKeyFrames>
                                                                            <ObjectAnimationUsingKeyFrames TargetName="Arrow" TargetProperty="Foreground">
                                                                                <ObjectAnimationUsingKeyFrames.KeyFrames>
                                                                                    <DiscreteObjectKeyFrame KeyTime="0" Value="{ThemeResource FlipViewNextPreviousArrowForegroundPointerOver}" />
                                                                                </ObjectAnimationUsingKeyFrames.KeyFrames>
                                                                            </ObjectAnimationUsingKeyFrames>
                                                                        </Storyboard.Children>
                                                                    </Storyboard>
                                                                </VisualState.Storyboard>
                                                            </VisualState>
                                                            <VisualState x:Name="Pressed">
                                                                <VisualState.Storyboard>
                                                                    <Storyboard>
                                                                        <Storyboard.Children>
                                                                            <ObjectAnimationUsingKeyFrames TargetName="Root" TargetProperty="Background">
                                                                                <ObjectAnimationUsingKeyFrames.KeyFrames>
                                                                                    <DiscreteObjectKeyFrame KeyTime="0" Value="{ThemeResource FlipViewNextPreviousButtonBackgroundPressed}" />
                                                                                </ObjectAnimationUsingKeyFrames.KeyFrames>
                                                                            </ObjectAnimationUsingKeyFrames>
                                                                            <ObjectAnimationUsingKeyFrames TargetName="Root" TargetProperty="BorderBrush">
                                                                                <ObjectAnimationUsingKeyFrames.KeyFrames>
                                                                                    <DiscreteObjectKeyFrame KeyTime="0" Value="{ThemeResource FlipViewNextPreviousButtonBorderBrushPressed}" />
                                                                                </ObjectAnimationUsingKeyFrames.KeyFrames>
                                                                            </ObjectAnimationUsingKeyFrames>
                                                                            <ObjectAnimationUsingKeyFrames TargetName="Arrow" TargetProperty="Foreground">
                                                                                <ObjectAnimationUsingKeyFrames.KeyFrames>
                                                                                    <DiscreteObjectKeyFrame KeyTime="0" Value="{ThemeResource FlipViewNextPreviousArrowForegroundPressed}" />
                                                                                </ObjectAnimationUsingKeyFrames.KeyFrames>
                                                                            </ObjectAnimationUsingKeyFrames>
                                                                            <DoubleAnimationUsingKeyFrames RepeatBehavior="Forever" TargetName="Arrow" TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)">
                                                                                <DoubleAnimationUsingKeyFrames.KeyFrames>
                                                                                    <DiscreteDoubleKeyFrame KeyTime="0.016" Value="{ThemeResource FlipViewButtonScalePressed}" />
                                                                                    <DiscreteDoubleKeyFrame KeyTime="30" Value="{ThemeResource FlipViewButtonScalePressed}" />
                                                                                </DoubleAnimationUsingKeyFrames.KeyFrames>
                                                                            </DoubleAnimationUsingKeyFrames>
                                                                            <DoubleAnimationUsingKeyFrames RepeatBehavior="Forever" TargetName="Arrow" TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)">
                                                                                <DoubleAnimationUsingKeyFrames.KeyFrames>
                                                                                    <DiscreteDoubleKeyFrame KeyTime="0.016" Value="{ThemeResource FlipViewButtonScalePressed}" />
                                                                                    <DiscreteDoubleKeyFrame KeyTime="30" Value="{ThemeResource FlipViewButtonScalePressed}" />
                                                                                </DoubleAnimationUsingKeyFrames.KeyFrames>
                                                                            </DoubleAnimationUsingKeyFrames>
                                                                        </Storyboard.Children>
                                                                    </Storyboard>
                                                                </VisualState.Storyboard>
                                                            </VisualState>
                                                        </VisualStateGroup.States>
                                                    </VisualStateGroup>
                                                </Border.VisualStateGroups>
                                                <Border.Child>
                                                    <FontIcon x:Name="Arrow"
                                                        HorizontalAlignment="Center"
                                                        VerticalAlignment="Center"
                                                        FontFamily="{ThemeResource SymbolThemeFontFamily}"
                                                        FontSize="{ThemeResource FlipViewButtonFontSize}"
                                                        Foreground="{ThemeResource FlipViewNextPreviousArrowForeground}"
                                                        Glyph=""
                                                        RenderTransformOrigin="0.5, 0.5"
                                                        UseLayoutRounding="False">
                                                        <FontIcon.RenderTransform>
                                                            <ScaleTransform x:Name="ScaleTransform" ScaleX="1" ScaleY="1" />
                                                        </FontIcon.RenderTransform>
                                                    </FontIcon>
                                                </Border.Child>
                                            </Border>
                                        </ControlTemplate.Template>
                                    </ControlTemplate>
                                    <ControlTemplate x:Key="HorizontalPreviousTemplate" TargetType="Button">
                                        <ControlTemplate.Template>
                                            <Border x:Name="Root" Background="{ThemeResource FlipViewNextPreviousButtonBackground}" BorderBrush="{ThemeResource FlipViewNextPreviousButtonBorderBrush}" BorderThickness="{ThemeResource FlipViewButtonBorderThemeThickness}" CornerRadius="{TemplateBinding CornerRadius}">
                                                <Border.VisualStateGroups>
                                                    <VisualStateGroup x:Name="CommonStates">
                                                        <VisualStateGroup.States>
                                                            <VisualState x:Name="Normal" />
                                                            <VisualState x:Name="PointerOver">
                                                                <VisualState.Storyboard>
                                                                    <Storyboard>
                                                                        <Storyboard.Children>
                                                                            <ObjectAnimationUsingKeyFrames TargetName="Root" TargetProperty="Background">
                                                                                <ObjectAnimationUsingKeyFrames.KeyFrames>
                                                                                    <DiscreteObjectKeyFrame KeyTime="0" Value="{ThemeResource FlipViewNextPreviousButtonBackgroundPointerOver}" />
                                                                                </ObjectAnimationUsingKeyFrames.KeyFrames>
                                                                            </ObjectAnimationUsingKeyFrames>
                                                                            <ObjectAnimationUsingKeyFrames TargetName="Root" TargetProperty="BorderBrush">
                                                                                <ObjectAnimationUsingKeyFrames.KeyFrames>
                                                                                    <DiscreteObjectKeyFrame KeyTime="0" Value="{ThemeResource FlipViewNextPreviousButtonBorderBrushPointerOver}" />
                                                                                </ObjectAnimationUsingKeyFrames.KeyFrames>
                                                                            </ObjectAnimationUsingKeyFrames>
                                                                            <ObjectAnimationUsingKeyFrames TargetName="Arrow" TargetProperty="Foreground">
                                                                                <ObjectAnimationUsingKeyFrames.KeyFrames>
                                                                                    <DiscreteObjectKeyFrame KeyTime="0" Value="{ThemeResource FlipViewNextPreviousArrowForegroundPointerOver}" />
                                                                                </ObjectAnimationUsingKeyFrames.KeyFrames>
                                                                            </ObjectAnimationUsingKeyFrames>
                                                                        </Storyboard.Children>
                                                                    </Storyboard>
                                                                </VisualState.Storyboard>
                                                            </VisualState>
                                                            <VisualState x:Name="Pressed">
                                                                <VisualState.Storyboard>
                                                                    <Storyboard>
                                                                        <Storyboard.Children>
                                                                            <ObjectAnimationUsingKeyFrames TargetName="Root" TargetProperty="Background">
                                                                                <ObjectAnimationUsingKeyFrames.KeyFrames>
                                                                                    <DiscreteObjectKeyFrame KeyTime="0" Value="{ThemeResource FlipViewNextPreviousButtonBackgroundPressed}" />
                                                                                </ObjectAnimationUsingKeyFrames.KeyFrames>
                                                                            </ObjectAnimationUsingKeyFrames>
                                                                            <ObjectAnimationUsingKeyFrames TargetName="Root" TargetProperty="BorderBrush">
                                                                                <ObjectAnimationUsingKeyFrames.KeyFrames>
                                                                                    <DiscreteObjectKeyFrame KeyTime="0" Value="{ThemeResource FlipViewNextPreviousButtonBorderBrushPressed}" />
                                                                                </ObjectAnimationUsingKeyFrames.KeyFrames>
                                                                            </ObjectAnimationUsingKeyFrames>
                                                                            <ObjectAnimationUsingKeyFrames TargetName="Arrow" TargetProperty="Foreground">
                                                                                <ObjectAnimationUsingKeyFrames.KeyFrames>
                                                                                    <DiscreteObjectKeyFrame KeyTime="0" Value="{ThemeResource FlipViewNextPreviousArrowForegroundPressed}" />
                                                                                </ObjectAnimationUsingKeyFrames.KeyFrames>
                                                                            </ObjectAnimationUsingKeyFrames>
                                                                            <DoubleAnimationUsingKeyFrames RepeatBehavior="Forever" TargetName="Arrow" TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)">
                                                                                <DoubleAnimationUsingKeyFrames.KeyFrames>
                                                                                    <DiscreteDoubleKeyFrame KeyTime="0.016" Value="{ThemeResource FlipViewButtonScalePressed}" />
                                                                                    <DiscreteDoubleKeyFrame KeyTime="30" Value="{ThemeResource FlipViewButtonScalePressed}" />
                                                                                </DoubleAnimationUsingKeyFrames.KeyFrames>
                                                                            </DoubleAnimationUsingKeyFrames>
                                                                            <DoubleAnimationUsingKeyFrames RepeatBehavior="Forever" TargetName="Arrow" TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)">
                                                                                <DoubleAnimationUsingKeyFrames.KeyFrames>
                                                                                    <DiscreteDoubleKeyFrame KeyTime="0.016" Value="{ThemeResource FlipViewButtonScalePressed}" />
                                                                                    <DiscreteDoubleKeyFrame KeyTime="30" Value="{ThemeResource FlipViewButtonScalePressed}" />
                                                                                </DoubleAnimationUsingKeyFrames.KeyFrames>
                                                                            </DoubleAnimationUsingKeyFrames>
                                                                        </Storyboard.Children>
                                                                    </Storyboard>
                                                                </VisualState.Storyboard>
                                                            </VisualState>
                                                        </VisualStateGroup.States>
                                                    </VisualStateGroup>
                                                </Border.VisualStateGroups>
                                                <Border.Child>
                                                    <FontIcon x:Name="Arrow"
                                                        HorizontalAlignment="Center"
                                                        VerticalAlignment="Center"
                                                        FontFamily="{ThemeResource SymbolThemeFontFamily}"
                                                        FontSize="{ThemeResource FlipViewButtonFontSize}"
                                                        Foreground="{ThemeResource FlipViewNextPreviousArrowForeground}"
                                                        Glyph=""
                                                        MirroredWhenRightToLeft="True"
                                                        RenderTransformOrigin="0.5, 0.5"
                                                        UseLayoutRounding="False">
                                                        <FontIcon.RenderTransform>
                                                            <ScaleTransform x:Name="ScaleTransform" ScaleX="1" ScaleY="1" />
                                                        </FontIcon.RenderTransform>
                                                    </FontIcon>
                                                </Border.Child>
                                            </Border>
                                        </ControlTemplate.Template>
                                    </ControlTemplate>
                                    <ControlTemplate x:Key="HorizontalNextTemplate" TargetType="Button">
                                        <ControlTemplate.Template>
                                            <Border x:Name="Root" Background="{ThemeResource FlipViewNextPreviousButtonBackground}" BorderBrush="{ThemeResource FlipViewNextPreviousButtonBorderBrush}" BorderThickness="{ThemeResource FlipViewButtonBorderThemeThickness}" CornerRadius="{TemplateBinding CornerRadius}">
                                                <Border.VisualStateGroups>
                                                    <VisualStateGroup x:Name="CommonStates">
                                                        <VisualStateGroup.States>
                                                            <VisualState x:Name="Normal" />
                                                            <VisualState x:Name="PointerOver">
                                                                <VisualState.Storyboard>
                                                                    <Storyboard>
                                                                        <Storyboard.Children>
                                                                            <ObjectAnimationUsingKeyFrames TargetName="Root" TargetProperty="Background">
                                                                                <ObjectAnimationUsingKeyFrames.KeyFrames>
                                                                                    <DiscreteObjectKeyFrame KeyTime="0" Value="{ThemeResource FlipViewNextPreviousButtonBackgroundPointerOver}" />
                                                                                </ObjectAnimationUsingKeyFrames.KeyFrames>
                                                                            </ObjectAnimationUsingKeyFrames>
                                                                            <ObjectAnimationUsingKeyFrames TargetName="Root" TargetProperty="BorderBrush">
                                                                                <ObjectAnimationUsingKeyFrames.KeyFrames>
                                                                                    <DiscreteObjectKeyFrame KeyTime="0" Value="{ThemeResource FlipViewNextPreviousButtonBorderBrushPointerOver}" />
                                                                                </ObjectAnimationUsingKeyFrames.KeyFrames>
                                                                            </ObjectAnimationUsingKeyFrames>
                                                                            <ObjectAnimationUsingKeyFrames TargetName="Arrow" TargetProperty="Foreground">
                                                                                <ObjectAnimationUsingKeyFrames.KeyFrames>
                                                                                    <DiscreteObjectKeyFrame KeyTime="0" Value="{ThemeResource FlipViewNextPreviousArrowForegroundPointerOver}" />
                                                                                </ObjectAnimationUsingKeyFrames.KeyFrames>
                                                                            </ObjectAnimationUsingKeyFrames>
                                                                        </Storyboard.Children>
                                                                    </Storyboard>
                                                                </VisualState.Storyboard>
                                                            </VisualState>
                                                            <VisualState x:Name="Pressed">
                                                                <VisualState.Storyboard>
                                                                    <Storyboard>
                                                                        <Storyboard.Children>
                                                                            <ObjectAnimationUsingKeyFrames TargetName="Root" TargetProperty="Background">
                                                                                <ObjectAnimationUsingKeyFrames.KeyFrames>
                                                                                    <DiscreteObjectKeyFrame KeyTime="0" Value="{ThemeResource FlipViewNextPreviousButtonBackgroundPressed}" />
                                                                                </ObjectAnimationUsingKeyFrames.KeyFrames>
                                                                            </ObjectAnimationUsingKeyFrames>
                                                                            <ObjectAnimationUsingKeyFrames TargetName="Root" TargetProperty="BorderBrush">
                                                                                <ObjectAnimationUsingKeyFrames.KeyFrames>
                                                                                    <DiscreteObjectKeyFrame KeyTime="0" Value="{ThemeResource FlipViewNextPreviousButtonBorderBrushPressed}" />
                                                                                </ObjectAnimationUsingKeyFrames.KeyFrames>
                                                                            </ObjectAnimationUsingKeyFrames>
                                                                            <ObjectAnimationUsingKeyFrames TargetName="Arrow" TargetProperty="Foreground">
                                                                                <ObjectAnimationUsingKeyFrames.KeyFrames>
                                                                                    <DiscreteObjectKeyFrame KeyTime="0" Value="{ThemeResource FlipViewNextPreviousArrowForegroundPressed}" />
                                                                                </ObjectAnimationUsingKeyFrames.KeyFrames>
                                                                            </ObjectAnimationUsingKeyFrames>
                                                                            <DoubleAnimationUsingKeyFrames RepeatBehavior="Forever" TargetName="Arrow" TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)">
                                                                                <DoubleAnimationUsingKeyFrames.KeyFrames>
                                                                                    <DiscreteDoubleKeyFrame KeyTime="0.016" Value="{ThemeResource FlipViewButtonScalePressed}" />
                                                                                    <DiscreteDoubleKeyFrame KeyTime="30" Value="{ThemeResource FlipViewButtonScalePressed}" />
                                                                                </DoubleAnimationUsingKeyFrames.KeyFrames>
                                                                            </DoubleAnimationUsingKeyFrames>
                                                                            <DoubleAnimationUsingKeyFrames RepeatBehavior="Forever" TargetName="Arrow" TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)">
                                                                                <DoubleAnimationUsingKeyFrames.KeyFrames>
                                                                                    <DiscreteDoubleKeyFrame KeyTime="0.016" Value="{ThemeResource FlipViewButtonScalePressed}" />
                                                                                    <DiscreteDoubleKeyFrame KeyTime="30" Value="{ThemeResource FlipViewButtonScalePressed}" />
                                                                                </DoubleAnimationUsingKeyFrames.KeyFrames>
                                                                            </DoubleAnimationUsingKeyFrames>
                                                                        </Storyboard.Children>
                                                                    </Storyboard>
                                                                </VisualState.Storyboard>
                                                            </VisualState>
                                                        </VisualStateGroup.States>
                                                    </VisualStateGroup>
                                                </Border.VisualStateGroups>
                                                <Border.Child>
                                                    <FontIcon x:Name="Arrow"
                                                        HorizontalAlignment="Center"
                                                        VerticalAlignment="Center"
                                                        FontFamily="{ThemeResource SymbolThemeFontFamily}"
                                                        FontSize="{ThemeResource FlipViewButtonFontSize}"
                                                        Foreground="{ThemeResource FlipViewNextPreviousArrowForeground}"
                                                        Glyph=""
                                                        MirroredWhenRightToLeft="True"
                                                        RenderTransformOrigin="0.5, 0.5"
                                                        UseLayoutRounding="False">
                                                        <FontIcon.RenderTransform>
                                                            <ScaleTransform x:Name="ScaleTransform" ScaleX="1" ScaleY="1" />
                                                        </FontIcon.RenderTransform>
                                                    </FontIcon>
                                                </Border.Child>
                                            </Border>
                                        </ControlTemplate.Template>
                                    </ControlTemplate>
                                </Grid.Resources>
                                <Grid.Children>
                                    <ScrollViewer x:Name="ScrollingHost"
                                        Padding="{TemplateBinding Padding}"
                                        AccessibilityView="Raw"
                                        BringIntoViewOnFocusChange="{TemplateBinding BringIntoViewOnFocusChange}"
                                        HorizontalScrollBarVisibility="{TemplateBinding HorizontalScrollBarVisibility}"
                                        HorizontalScrollMode="{TemplateBinding HorizontalScrollMode}"
                                        HorizontalSnapPointsType="MandatorySingle"
                                        IsDeferredScrollingEnabled="{TemplateBinding IsDeferredScrollingEnabled}"
                                        IsHorizontalRailEnabled="{TemplateBinding IsHorizontalRailEnabled}"
                                        IsHorizontalScrollChainingEnabled="{TemplateBinding IsHorizontalScrollChainingEnabled}"
                                        IsTabStop="False"
                                        IsVerticalRailEnabled="{TemplateBinding IsVerticalRailEnabled}"
                                        IsVerticalScrollChainingEnabled="{TemplateBinding IsVerticalScrollChainingEnabled}"
                                        TabNavigation="{TemplateBinding TabNavigation}"
                                        VerticalScrollBarVisibility="{TemplateBinding VerticalScrollBarVisibility}"
                                        VerticalScrollMode="{TemplateBinding VerticalScrollMode}"
                                        VerticalSnapPointsType="MandatorySingle"
                                        ZoomMode="Disabled">
                                        <ScrollViewer.Content>
                                            <ItemsPresenter />
                                        </ScrollViewer.Content>
                                    </ScrollViewer>
                                    <Button x:Name="PreviousButtonHorizontal"
                                        Width="{StaticResource ArrowScrollViewerButtonWidth}"
                                        Height="{StaticResource ArrowScrollViewerButtonHeight}"
                                        Margin="8"
                                        HorizontalAlignment="Left"
                                        VerticalAlignment="Center"
                                        CornerRadius="{StaticResource ArrowScrollViewerButtonCornerRadius}"
                                        IsTabStop="False"
                                        Template="{StaticResource HorizontalPreviousTemplate}"
                                        UseSystemFocusVisuals="False" />
                                    <Button x:Name="NextButtonHorizontal"
                                        Width="{StaticResource ArrowScrollViewerButtonWidth}"
                                        Height="{StaticResource ArrowScrollViewerButtonHeight}"
                                        Margin="8"
                                        HorizontalAlignment="Right"
                                        VerticalAlignment="Center"
                                        CornerRadius="{StaticResource ArrowScrollViewerButtonCornerRadius}"
                                        IsTabStop="False"
                                        Template="{StaticResource HorizontalNextTemplate}"
                                        UseSystemFocusVisuals="False" />
                                    <Button x:Name="PreviousButtonVertical"
                                        Width="{StaticResource ArrowScrollViewerButtonWidth}"
                                        Height="{StaticResource ArrowScrollViewerButtonHeight}"
                                        Margin="8"
                                        HorizontalAlignment="Center"
                                        VerticalAlignment="Top"
                                        CornerRadius="{StaticResource ArrowScrollViewerButtonCornerRadius}"
                                        IsTabStop="False"
                                        Template="{StaticResource VerticalPreviousTemplate}"
                                        UseSystemFocusVisuals="False" />
                                    <Button x:Name="NextButtonVertical"
                                        Width="{StaticResource ArrowScrollViewerButtonWidth}"
                                        Height="{StaticResource ArrowScrollViewerButtonHeight}"
                                        Margin="8"
                                        HorizontalAlignment="Center"
                                        VerticalAlignment="Bottom"
                                        CornerRadius="{StaticResource ArrowScrollViewerButtonCornerRadius}"
                                        IsTabStop="False"
                                        Template="{StaticResource VerticalNextTemplate}"
                                        UseSystemFocusVisuals="False" />
                                </Grid.Children>
                            </Grid>
                        </ControlTemplate.Template>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <DataTemplate x:Key="AgeRestrictedDataTemplate">
            <DataTemplate.Template>
                <ConstrainedBox AspectRatio="16:9">
                    <ConstrainedBox.Content>
                        <ContentControl Style="{StaticResource ImageContentControlStyle}">
                            <ContentControl.Behaviors>
                                <ViewDisplayedBehavior />
                            </ContentControl.Behaviors>
                            <ContentControl.Content>
                                <ResponsiveTileButton AutomationId="ScreenshotsAgeGatingButton" IsTabStop="False" Style="{StaticResource ScreenshotMosaicTileButtonStyle}">
                                    <ResponsiveTileButton.Content>
                                        <Grid Background="{ThemeResource CardBackgroundFillColorDefaultBrush}">
                                            <Grid.Children>
                                                <TileImage HorizontalAlignment="Stretch" VerticalAlignment="Stretch" ShowBackgroundColor="False" />
                                                <Rectangle Fill="{ThemeResource ImageOpacityOverlayBackgroundBrush}">
                                                    <Rectangle.Opacity>
                                                        <Binding Path="PointerElementOpacity" FallbackValue="0">
                                                            <Binding.RelativeSource>
                                                                <RelativeSource Mode="TemplatedParent" />
                                                            </Binding.RelativeSource>
                                                        </Binding>
                                                    </Rectangle.Opacity>
                                                </Rectangle>
                                                <StackPanel Padding="12" HorizontalAlignment="Center" VerticalAlignment="Center" Background="{ThemeResource HighContrastBackgroundBrush}">
                                                    <StackPanel.Children>
                                                        <TextBlock
                                                            AccessibilityView="Raw"
                                                            AutomationId="ScreenshotsAgeGatingMessage"
                                                            Foreground="{ThemeResource WhiteTextForegroundBrush}"
                                                            Style="{StaticResource BodyTextBlockStyle}"
                                                            TextAlignment="Center" />
                                                        <TextBlock
                                                            Margin="0,8,0,0"
                                                            AccessibilityView="Raw"
                                                            AutomationId="ScreenshotsSignInMessage"
                                                            FontWeight="SemiBold"
                                                            Foreground="{ThemeResource WhiteTextForegroundBrush}"
                                                            Style="{StaticResource BodyTextBlockStyle}"
                                                            TextAlignment="Center" />
                                                    </StackPanel.Children>
                                                </StackPanel>
                                            </Grid.Children>
                                        </Grid>
                                    </ResponsiveTileButton.Content>
                                </ResponsiveTileButton>
                            </ContentControl.Content>
                        </ContentControl>
                    </ConstrainedBox.Content>
                </ConstrainedBox>
            </DataTemplate.Template>
        </DataTemplate>
    </OverlayPopupBase.Resources>
    <OverlayPopupBase.Content>
        <Grid x:Name="ViewerGrid">
            <Grid.Children>
                <Rectangle Fill="{ThemeResource AcrylicInAppFillColorThinBrush}">
                    <Rectangle.ShowAnimations>
                        <OpacityAnimation From="0" To="1" Duration="0:0:0.3" />
                    </Rectangle.ShowAnimations>
                    <Rectangle.HideAnimations>
                        <OpacityAnimation From="1" To="0" Duration="0:0:0.2" />
                    </Rectangle.HideAnimations>
                </Rectangle>
                <Grid x:Name="BackgroundContainer" Margin="32">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <Grid.Children>
                        <Button x:Name="CloseButton" x:Uid="ClosePopupButtonText" Margin="0,24,0,12" HorizontalAlignment="Right" NormalizedCenterPoint="0.5" Style="{ThemeResource SubtleIconButtonStyle}">
                            <Button.Content>
                                <TextBlock HorizontalAlignment="Center" VerticalAlignment="Center" Style="{StaticResource StoreGlyph16TextBlockStyle}" Text="{StaticResource StoreGlyphCancel}" />
                            </Button.Content>
                            <Button.ShowAnimations>
                                <OpacityAnimation From="0" To="1" Duration="0:0:0.4" />
                                <TranslationAnimation From="0,-24,0" To="0" Duration="0:0:0.4" />
                                <RotationInDegreesAnimation From="-180" To="0" Duration="0:0:0.4" />
                            </Button.ShowAnimations>
                            <Button.HideAnimations>
                                <OpacityAnimation From="1" To="0" Duration="0:0:0.2" />
                                <TranslationAnimation From="0" To="0,-8,0" Duration="0:0:0.2" />
                                <RotationInDegreesAnimation From="0" To="-35" Duration="0:0:0.2" />
                            </Button.HideAnimations>
                        </Button>
                        <FlipView x:Name="ItemsFlipView"
                            Row="1"
                            Margin="0,24,0,0"
                            Background="#00FFFFFF"
                            ItemTemplateSelector="{StaticResource FlipViewDataTemplateSelector}"
                            Style="{StaticResource CircleArrowScrollViewerButtonFlipViewStyle}">
                            <FlipView.Resources>
                                <Style BasedOn="{StaticResource DefaultButtonStyle}" TargetType="Button">
                                    <Setter Property="Shadow" Value="{StaticResource HorizontalArrowScrollViewerButtonShadow}" />
                                    <Setter Property="ShowAnimations">
                                        <Setter.Value>
                                            <ImplicitAnimationSet>
                                                <OpacityAnimation From="0" To="1" Duration="0:0:0.4" />
                                            </ImplicitAnimationSet>
                                        </Setter.Value>
                                    </Setter>
                                    <Setter Property="HideAnimations">
                                        <Setter.Value>
                                            <ImplicitAnimationSet>
                                                <OpacityAnimation To="0" Duration="0:0:0.4" />
                                            </ImplicitAnimationSet>
                                        </Setter.Value>
                                    </Setter>
                                </Style>
                            </FlipView.Resources>
                            <FlipView.ShowAnimations>
                                <OpacityAnimation From="0" To="1" Duration="0:0:0.3" />
                            </FlipView.ShowAnimations>
                            <FlipView.HideAnimations>
                                <OpacityAnimation From="1" To="0" Duration="0:0:0.2" />
                            </FlipView.HideAnimations>
                        </FlipView>
                        <TextBlock x:Name="CaptionTextBlock"
                            Row="2"
                            Margin="0,12"
                            HorizontalAlignment="Center"
                            FontSize="16"
                            FontWeight="SemiBold"
                            HorizontalTextAlignment="Center"
                            TextWrapping="Wrap">
                            <TextBlock.ShowAnimations>
                                <OpacityAnimation Delay="0:0:0.2" From="0" To="1" Duration="0:0:0.3" />
                                <TranslationAnimation Delay="0:0:0.2" From="0" To="0,12,0" Duration="0:0:0.3" />
                            </TextBlock.ShowAnimations>
                            <TextBlock.HideAnimations>
                                <OpacityAnimation From="1" To="0" Duration="0:0:0.15" />
                                <TranslationAnimation From="0,12,0" To="0" Duration="0:0:0.15" />
                            </TextBlock.HideAnimations>
                        </TextBlock>
                        <Grid x:Name="IndexTextBlock"
                            Row="3"
                            MinWidth="80"
                            HorizontalAlignment="Center"
                            Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                            CornerRadius="16">
                            <Grid.ShowAnimations>
                                <OpacityAnimation Delay="0:0:0.25" From="0" To="1" Duration="0:0:0.3" />
                                <TranslationAnimation Delay="0:0:0.25" From="0" To="0,12,0" Duration="0:0:0.3" />
                            </Grid.ShowAnimations>
                            <Grid.HideAnimations>
                                <OpacityAnimation From="1" To="0" Duration="0:0:0.15" />
                                <TranslationAnimation From="0,12,0" To="0" Duration="0:0:0.15" />
                            </Grid.HideAnimations>
                            <Grid.Children>
                                <TextBlock Margin="16,10" TextAlignment="Center" TextLineBounds="Tight">
                                    <TextBlock.Inlines>
                                        <Run FontWeight="SemiBold" />
                                        <Verbatim Value=" " />
                                        <Run Foreground="{ThemeResource TextFillColorSecondaryBrush}" Text="/" />
                                        <Verbatim Value=" " />
                                        <Run Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                    </TextBlock.Inlines>
                                </TextBlock>
                            </Grid.Children>
                        </Grid>
                    </Grid.Children>
                </Grid>
            </Grid.Children>
        </Grid>
    </OverlayPopupBase.Content>
</OverlayPopupBase>