<?xml version="1.0" encoding="utf-8" ?>
<Page x:Class="DevWinUIGallery.Views.StoreCarousel2Page"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:dev="using:DevWinUI"
      xmlns:local="using:DevWinUIGallery"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      mc:Ignorable="d">

    <ScrollViewer>
        <StackPanel Padding="24" dev:PanelAttach.ChildrenTransitions="Default" Spacing="16">
            <local:ControlExample Title="Store Carousel 2" CSharp="Composition/StoreCarousel2/StoreCarousel2Page_Card_cs.txt" Doc="controls/storeCarousel2" Xaml="Composition/StoreCarousel2/StoreCarousel2Page_xaml.txt">
                <local:ControlExample.Options>
                    <local:OptionPanel>
                        <ToggleSwitch x:Name="TGCardAgeRestricted" Header="AgeRestricted" IsOn="False" />
                        <ToggleSwitch x:Name="TGCardIsAgeBlocked" Header="IsAgeBlocked" IsOn="False" />
                    </local:OptionPanel>
                </local:ControlExample.Options>
                <dev:Card Title="Screenshots" Padding="0">
                    <dev:Card.TitleContent>
                        <Button x:Name="ShowAllIconButton" Margin="0,0,16,0" Click="ShowAllIconButton_Click" Style="{StaticResource CardRightChevronButtonStyle}" ToolTipService.ToolTip="See all" />
                    </dev:Card.TitleContent>
                    <dev:StoreCarousel2 x:Name="StoreCarousel2" AgeRestricted="{x:Bind TGCardAgeRestricted.IsOn, Mode=OneWay}" IsAgeBlocked="{x:Bind TGCardIsAgeBlocked.IsOn, Mode=OneWay}" ItemsSource="{x:Bind Media}" SignInClicked="StoreCarousel2_SignInClicked" />
                </dev:Card>
            </local:ControlExample>

        </StackPanel>
    </ScrollViewer>

</Page>
